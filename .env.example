HOST=127.0.0.1
PORT=7676
# Owner password is generated by `devspace init`; only its Argon2id verifier is
# stored in ~/.devspace/auth.json. Set the plaintext only for env-driven runs.
# DEVSPACE_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret
# Env-only deployments should also set an independent persistent base64url
# master key. Without it, DevSpace enters legacy-direct compatibility mode.
# DEVSPACE_MASTER_KEY=replace-with-32-random-base64url-bytes
# Optional OAuth tuning.
# DEVSPACE_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# DEVSPACE_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# DEVSPACE_OAUTH_SCOPES=workspace:read,workspace:write,process:execute,network:access,worktree:create,workspace:revoke
# DEVSPACE_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1
DEVSPACE_ALLOWED_ROOTS=/home/waishnav/personal,/home/waishnav/work
# For temporary tunnels, prefer setting this per run. DevSpace derives the
# inbound Host allowlist from this URL.
# DEVSPACE_PUBLIC_BASE_URL=https://your-public-host.example.com
# Advanced escape hatch. `*` disables Host header allowlist protection.
# DEVSPACE_ALLOWED_HOSTS=localhost,127.0.0.1,your-public-host.example.com
# off | changes | full. Defaults to changes.
# changes creates one aggregate review widget via review_changes instead of per-tool iframes.
DEVSPACE_WIDGETS=changes
# browse exposes only static lifecycle/read/inspection tools; coding adds
# mutation, process, Skill, operation-status, worktree, and revocation tools.
DEVSPACE_TOOL_PROFILE=coding
DEVSPACE_LOG_LEVEL=info
DEVSPACE_LOG_FORMAT=json
DEVSPACE_LOG_REQUESTS=1
DEVSPACE_LOG_ASSETS=0
DEVSPACE_LOG_TOOL_CALLS=1
DEVSPACE_LOG_SHELL_COMMANDS=0
# Persistent safe audit events are independent of console log verbosity.
DEVSPACE_AUDIT_EVENTS=1
# DEVSPACE_TRUST_PROXY=1
# DEVSPACE_STATE_DIR=/home/waishnav/.local/share/devspace
# DEVSPACE_WORKTREE_ROOT=/home/waishnav/.devspace/worktrees
# Persisted process output: 64 MiB per output, 1 GiB total, retained for 24 hours.
# DEVSPACE_MAX_PROCESS_OUTPUT_FILE_BYTES=67108864
# DEVSPACE_MAX_PROCESS_OUTPUT_STORAGE_BYTES=1073741824
# DEVSPACE_COMPLETED_PROCESS_OUTPUT_TTL_SECONDS=86400
# Optional user-level instructions. Unset by default; ~/.codex/AGENTS.md is not loaded implicitly.
# DEVSPACE_USER_INSTRUCTIONS_PATH=~/.devspace/AGENTS.md
# Skills are enabled by default. Set DEVSPACE_SKILLS=0 to hide them.
# DEVSPACE_SKILLS=0
# Compatibility Skill root only; its skills child is loaded, not AGENTS.md.
# DEVSPACE_AGENT_DIR=/home/waishnav/.codex
# DEVSPACE_SKILL_PATHS=/home/waishnav/.codex/skills,/home/waishnav/.claude/skills
# DEVSPACE_DISABLED_SKILL_PATHS=project/.agents/skills/disabled,/home/waishnav/.agents/skills/old/SKILL.md
# DEVSPACE_ADMIN_SKILLS_DIR=/etc/codex/skills
